<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Astrolabe.WinRTExtension</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <EnableComHosting>true</EnableComHosting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <Target Name="CopyClsidmapToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(IntermediateOutputPath)$(AssemblyName).clsidmap"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(IntermediateOutputPath)$(AssemblyName).clsidmap')" />
  </Target>
</Project>